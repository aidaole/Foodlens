{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "foodlens-recognition",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-14",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BUDGET",
        "class_name": "RecognitionBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RecognitionBudget"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "REQUEST_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "vars": {
    "MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "DAILY_LIMIT": "25",
    "DEVICE_DAILY_LIMIT": "16",
    "MODEL_ENABLED": "true",
    "BILLING_ENABLED": "false",
    "ALLOW_SANDBOX_SUBSCRIPTIONS": "false",
    "ALLOWED_ORIGINS": "http://localhost:8081,https://foodlens-recognition.aidaole.workers.dev"
  },
  "observability": {
    "enabled": false
  },
  "account_id": "3ca51fed70c3f6c00290d34aacb28bcd"
}
