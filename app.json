{
  "expo": {
    "name": "食刻 FoodLens",
    "slug": "foodlens",
    "version": "0.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.foodlens.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.foodlens.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#D6F87C"
      },
      "versionCode": 7
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "允许食刻拍摄食品配料表和营养成分表，用于标签分析。",
          "photosPermission": "允许食刻选择食品包装图片，用于标签分析。",
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "scheme": "foodlens"
  }
}
